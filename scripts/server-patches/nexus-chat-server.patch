+            disabled={isLoading || !username || !password}
+            style={{ width: '100%' }}
+          >
+            <LogIn size={16} />
+            <span>{isLoading ? 'Signing in…' : 'Sign In'}</span>
+            <ArrowRight size={16} />
+          </button>
+        </form>
+      </div>
+    </div>
+  )
+}

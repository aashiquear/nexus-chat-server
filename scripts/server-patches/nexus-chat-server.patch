+              <tspan> · </tspan>
+              <tspan className="tag-word tag-word-2">RAG</tspan>
+              <tspan> · </tspan>
+              <tspan className="tag-word tag-word-3">MCP</tspan>
+              <tspan> · </tspan>
+              <tspan className="tag-word tag-word-4">MULTI-LLM</tspan>
+            </text>
+          </svg>
+        </div>
+
+        <form onSubmit={handleSubmit} style={{ width: '100%', maxWidth: 320 }}>
+          <div style={{ marginBottom: 12 }}>
+            <input
+              type="text"
+              placeholder="Username"
+              value={username}
+              onChange={(e) => setUsername(e.target.value)}
+              className="chat-input-field"
+              style={{ width: '100%', padding: '10px 14px', borderRadius: 8, border: '1px solid var(--border)' }}
+              autoFocus
+            />
+          </div>
+          <div style={{ marginBottom: 16 }}>
+            <input
+              type="password"
+              placeholder="Password"
+              value={password}
+              onChange={(e) => setPassword(e.target.value)}
+              className="chat-input-field"
+              style={{ width: '100%', padding: '10px 14px', borderRadius: 8, border: '1px solid var(--border)' }}
+            />
+          </div>
+          {error && (

+                <line className="conn-line" x1="-50" y1="50" x2="0" y2="10" stroke="#89b5a6" strokeWidth="2.8" strokeLinecap="round" />
+                <line className="conn-line" x1="50" y1="50" x2="0" y2="10" stroke="#89b5a6" strokeWidth="2.8" strokeLinecap="round" />
+                <line className="conn-line" x1="-60" y1="-50" x2="60" y2="-50" stroke="#96c0b2" strokeWidth="2.2" strokeLinecap="round" />

# ============================================================
# Nexus Chat Server - Environment Variables
# ============================================================
# Copy this file to .env and fill in required values.
# ============================================================

# Required on first run — used to bootstrap the admin account
NEXUS_ADMIN_PASSWORD=your-secure-password-here

# Strongly recommended in production (any long random string)
NEXUS_JWT_SECRET=your-random-secret-here

# Ollama server address (from inside Docker, host.docker.internal reaches the host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Ollama Cloud: OLLAMA_BASE_URL=https://ollama.com/api plus the key below
OLLAMA_API_KEY=

# --- Optional cloud providers (off by default) ---
NEXUS_ENABLE_ANTHROPIC=false
ANTHROPIC_API_KEY=
NEXUS_ENABLE_OPENAI=false
OPENAI_API_KEY=

# --- Tool API Keys ---
SEARCH_API_KEY=

# --- Sandbox / MCP ---
# NEXUS_SANDBOX_URL=http://nexus-sandbox:8500
# MCP_REGISTRY_URL=https://registry.modelcontextprotocol.io/v0.1/servers
